config_version=5

[application]

config/name="Voxel Engine"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Settings="*res://scripts/autoload/settings.gd"
ModManager="*res://scripts/autoload/mod_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
Mods="*res://scripts/autoload/mod_runtime.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
